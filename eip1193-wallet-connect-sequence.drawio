        <mxCell id="title" value="&lt;b&gt;EIP-1193 钱包连接授权时序图&lt;/b&gt;&lt;br&gt;DApp 调用 eth_requestAccounts 完整流程" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="50" as="geometry" />
