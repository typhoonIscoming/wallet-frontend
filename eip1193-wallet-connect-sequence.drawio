          <mxGeometry x="600" y="90" width="160" height="1050" as="geometry" />
        </mxCell>

        <!-- Background Script -->
        <mxCell id="actor_background" value="&lt;b&gt;Background Script&lt;/b&gt;&lt;br&gt;(background.ts)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=60;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="160" height="1050" as="geometry" />
        </mxCell>

        <!-- Popup UI -->
        <mxCell id="actor_popup" value="&lt;b&gt;Popup UI&lt;/b&gt;&lt;br&gt;(AuthPage.tsx)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=60;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="90" width="160" height="1050" as="geometry" />
        </mxCell>

        <!-- 用户 -->
        <mxCell id="actor_user" value="&lt;b&gt;用户&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};size=60;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="90" width="120" height="1050" as="geometry" />
        </mxCell>

        <!-- ========== 阶段1: Provider 注入（初始化阶段） ========== -->
        <mxCell id="phase1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8FF;strokeColor=#4682B4;strokeWidth=1;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="1120" height="100" as="geometry" />
        </mxCell>
        <mxCell id="phase1_label" value="&lt;b&gt;阶段 1: Provider 注入（页面加载时）&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#4682B4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="172" width="250" height="20" as="geometry" />
        </mxCell>

        <!-- 1. Content Script 注入 Provider -->
        <mxCell id="msg1" value="1. document_start: 注入 &lt;script src=&quot;inject-provider.js&quot;&gt;" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;exitX=1;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1">
          <mxGeometry x="0.02" relative="1" as="geometry">
            <mxPoint x="680" y="200" as="sourcePoint" />
            <mxPoint x="420" y="200" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 2. 创建 window.ethereum -->
        <mxCell id="msg2" value="2. 创建 window.ethereum (EIP-1193 Provider)&lt;br&gt;触发 ethereum#initialized 事件" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="240" as="sourcePoint" />
            <mxPoint x="160" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ========== 阶段2: DApp 发起连接请求 ========== -->
        <mxCell id="phase2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#D2691E;strokeWidth=1;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="290" width="1120" height="250" as="geometry" />
        </mxCell>
        <mxCell id="phase2_label" value="&lt;b&gt;阶段 2: DApp 发起连接请求&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#D2691E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="292" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- 3. DApp 调用 eth_requestAccounts -->
        <mxCell id="msg3" value="3. ethereum.request({&lt;br&gt;  method: 'eth_requestAccounts'&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontStyle=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="330" as="sourcePoint" />
            <mxPoint x="420" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 4. sendRpcRequest 生成 messageId -->
        <mxCell id="msg4_note" value="sendRpcRequest()&lt;br&gt;生成唯一 messageId&lt;br&gt;注册 responseHandler 监听响应" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="345" y="340" width="155" height="55" as="geometry" />
        </mxCell>

        <!-- 5. postMessage 到 Content Script -->
        <mxCell id="msg5" value="4. window.postMessage({&lt;br&gt;  source: 'wxt-eip1193-page',&lt;br&gt;  messageId, method, params&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontColor=#1a5276;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="420" y="420" as="sourcePoint" />
            <mxPoint x="680" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Content Script 验证消息 -->
        <mxCell id="msg5_note" value="验证:&lt;br&gt;source === 'wxt-eip1193-page'&lt;br&gt;event.source === window" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="608" y="430" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- 6. 转发到 Background -->
        <mxCell id="msg6" value="5. browser.runtime.sendMessage({&lt;br&gt;  type: 'EIP1193_REQUEST',&lt;br&gt;  method: 'eth_requestAccounts',&lt;br&gt;  params&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontColor=#6c3483;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="500" as="sourcePoint" />
            <mxPoint x="960" y="500" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ========== 阶段3: Background 处理请求 ========== -->
        <mxCell id="phase3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F0FF;strokeColor=#8B008B;strokeWidth=1;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="1520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="phase3_label" value="&lt;b&gt;阶段 3: Background 路由处理 &amp;amp; 打开授权弹窗&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#8B008B;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="552" width="310" height="20" as="geometry" />
        </mxCell>

        <!-- 7. Router 分发 -->
        <mxCell id="msg7_note" value="handleEIP1193Request()&lt;br&gt;router.ts 路由到&lt;br&gt;handleEthRequestAccounts()&lt;br&gt;&lt;br&gt;检查钱包已解锁 ✓&lt;br&gt;检查账户存在 ✓" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="885" y="520" width="155" height="85" as="geometry" />
        </mxCell>

        <!-- 8. requestUserAuth -->
        <mxCell id="msg8_note" value="requestUserAuth(origin)&lt;br&gt;1. 生成 requestId&lt;br&gt;2. 存入 pendingAuthRequests Map&lt;br&gt;3. 创建 Promise (resolve/reject)&lt;br&gt;4. 启动 30s 超时定时器" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="885" y="615" width="180" height="75" as="geometry" />
        </mxCell>

        <!-- 9. 打开 Popup -->
        <mxCell id="msg9" value="6. openPopup() + setCurrentPopupRoute('auth')&lt;br&gt;sendMessage({ type: 'POPUP_ROUTE_CHANGED', route: 'auth' })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontColor=#c0392b;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="710" as="sourcePoint" />
            <mxPoint x="1240" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 10. Popup 获取授权请求 -->
        <mxCell id="msg10" value="7. sendMessage({ type: 'AUTH_REQUEST_GET' })" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontColor=#c0392b;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="745" as="sourcePoint" />
            <mxPoint x="960" y="745" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 11. 返回授权请求信息 -->
        <mxCell id="msg11" value="8. 返回 { requests: [{ requestId, origin, timestamp }] }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;fontSize=10;fontColor=#c0392b;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="775" as="sourcePoint" />
            <mxPoint x="1240" y="775" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ========== 阶段4: 用户授权 ========== -->
        <mxCell id="phase4_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#CC0000;strokeWidth=1;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="820" width="1520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phase4_label" value="&lt;b&gt;阶段 4: 用户确认授权&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#CC0000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="822" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- 12. 显示授权界面 -->
        <mxCell id="msg12" value="9. 显示授权弹窗:&lt;br&gt;网站: {origin}&lt;br&gt;账户: {address}&lt;br&gt;[拒绝] [授权]" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="860" as="sourcePoint" />
            <mxPoint x="1480" y="860" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 13. 用户点击授权 -->
        <mxCell id="msg13" value="10. 用户点击 [授权] 按钮" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontStyle=1;fontColor=#006400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1480" y="910" as="sourcePoint" />
            <mxPoint x="1240" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ========== 阶段5: 响应回传 ========== -->
        <mxCell id="phase5_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FFF0;strokeColor=#228B22;strokeWidth=1;dashed=1;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="50" y="950" width="1520" height="170" as="geometry" />
        </mxCell>
        <mxCell id="phase5_label" value="&lt;b&gt;阶段 5: 授权结果回传&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontColor=#228B22;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="952" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- 14. Popup 发送批准消息 -->
        <mxCell id="msg14" value="11. sendMessage({&lt;br&gt;  type: 'AUTH_REQUEST_APPROVE',&lt;br&gt;  requestId,&lt;br&gt;  accounts: [address]&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;fontColor=#006400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="1000" as="sourcePoint" />
            <mxPoint x="960" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 15. resolve Promise -->
        <mxCell id="msg15_note" value="pendingAuthRequests.get(requestId)&lt;br&gt;request.resolve(accounts)&lt;br&gt;pendingAuthRequests.delete(requestId)&lt;br&gt;&lt;br&gt;→ Promise 完成，sendResponse 被调用" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="885" y="1008" width="210" height="70" as="geometry" />
        </mxCell>

        <!-- 16. 返回结果给 Content Script -->
        <mxCell id="msg16" value="12. sendResponse({&lt;br&gt;  success: true,&lt;br&gt;  result: ['0x...address']&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;fontSize=10;fontColor=#006400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="960" y="1060" as="sourcePoint" />
            <mxPoint x="680" y="1060" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 17. Content Script 通过 postMessage 返回 -->
        <mxCell id="msg17" value="13. window.postMessage({&lt;br&gt;  source: 'wxt-eip1193-content',&lt;br&gt;  messageId,&lt;br&gt;  result: ['0x...address']&lt;br&gt;})" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;fontSize=10;fontColor=#006400;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="680" y="1095" as="sourcePoint" />
            <mxPoint x="420" y="1095" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 18. Provider 返回结果给 DApp -->
        <mxCell id="msg18_note" value="responseHandler 匹配 messageId&lt;br&gt;触发 accountsChanged 事件&lt;br&gt;触发 connect 事件&lt;br&gt;resolve(accounts)" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="1098" width="175" height="60" as="geometry" />
        </mxCell>

        <!-- ========== 通信协议图例 ========== -->
        <mxCell id="legend_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="1160" width="700" height="170" as="geometry" />
        </mxCell>
        <mxCell id="legend_title" value="&lt;b&gt;通信协议说明&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1165" width="120" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend1" value="" style="endArrow=block;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="1210" as="sourcePoint" />
            <mxPoint x="170" y="1210" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend1_text" value="同步请求 / 函数调用" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="1200" width="130" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend2" value="" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="1240" as="sourcePoint" />
            <mxPoint x="170" y="1240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="legend2_text" value="异步响应 / 回调返回" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="1230" width="130" height="20" as="geometry" />
        </mxCell>

        <mxCell id="legend3_text" value="&lt;b&gt;通信方式:&lt;/b&gt;&lt;br&gt;• DApp ↔ Provider: 函数调用 (同一 JS 上下文)&lt;br&gt;• Provider ↔ Content Script: window.postMessage (跨上下文)&lt;br&gt;• Content Script ↔ Background: browser.runtime.sendMessage (扩展内部)&lt;br&gt;• Background ↔ Popup: browser.runtime.sendMessage (扩展内部)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1260" width="340" height="80" as="geometry" />
        </mxCell>

        <!-- 消息标识说明 -->
        <mxCell id="legend4_text" value="&lt;b&gt;关键消息标识:&lt;/b&gt;&lt;br&gt;• source: 'wxt-eip1193-page' — 页面→Content Script&lt;br&gt;• source: 'wxt-eip1193-content' — Content Script→页面&lt;br&gt;• type: 'EIP1193_REQUEST' — Content Script→Background&lt;br&gt;• type: 'AUTH_REQUEST_*' — Popup ↔ Background&lt;br&gt;• type: 'POPUP_ROUTE_CHANGED' — Background→Popup" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="1260" width="320" height="100" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
